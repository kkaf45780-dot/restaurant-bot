{
  "name": "restaurant-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true
  },
  "vars": {
    "APP_VERSION": "2.0.0"
  }
  // Bind Cloudflare KV for distributed rate-limiting & state:
  // npx wrangler kv namespace create RATE_LIMIT_KV
  // npx wrangler kv namespace create RESTAURANT_DB
  // "kv_namespaces": [
  //   { "binding": "RATE_LIMIT_KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" },
  //   { "binding": "RESTAURANT_DB", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  // ]
}
