{
  "name": "restaurant-bot",
  "main": "src/worker.ts",
  "compatibility_date": "2025-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ADMIN_EMAIL": "admin@hara-grill.eg"
  }
  // اختياري للخطة المجانية عند عدم استخدام Supabase:
  // يمكنك ربط Cloudflare KV مجاناً لحفظ الطلبات والمنيو بدلاً من الذاكرة المؤقتة:
  // 1) نفّذ الأمر: npx wrangler kv namespace create RESTAURANT_DB
  // 2) أزل التعليق أدناه وضع الـ id الناتج:
  // "kv_namespaces": [
  //   {
  //     "binding": "RESTAURANT_DB",
  //     "id": "REPLACE_WITH_KV_NAMESPACE_ID"
  //   }
  // ]
}
