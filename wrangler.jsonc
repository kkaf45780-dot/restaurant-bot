{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "moazzaf-almatam",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "moazzaf-almatam",
      "database_id": "CREATE_D1_DATABASE_AND_REPLACE_THIS_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "moazzaf-almatam-uploads"
    }
  ],
  "vars": {
    "APP_ENV": "production"
  }
}
